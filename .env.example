# Server settings: copy into frontend/.env.local for local Next.js usage.
# Use an absolute path on a persistent POSIX volume. Never commit its contents.
EMISSION_LENS_STORE_PATH=/absolute/persistent/path/emission-lens/worker-store.json
# Generate a private random token of at least 32 characters; use the same on worker.
EMISSION_LENS_WORKER_TOKEN=
# Worker process only: HTTPS endpoint, or an authenticated loopback SSH tunnel.
EMISSION_LENS_INGEST_URL=http://127.0.0.1:43012/api/worker
